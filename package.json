{
  "name": "marklist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "db:up": "scripts/db-up.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "contract:update": "tsx scripts/openapi.ts > openapi.json",
    "perf": "tsx scripts/perf.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@hono/zod-openapi": "1.6.3",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.16",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/autocannon": "7.12.7",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "8.20.0",
    "autocannon": "8.0.0",
    "dependency-cruiser": "18.4.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.1",
    "jscpd": "5.4.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
